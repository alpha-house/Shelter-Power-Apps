<?xml version="1.0" encoding="utf-8"?>
<manifest>
  <control
    namespace="CpShelter"
    constructor="ServiceTransactions"
    version="1.0.1"
    display-name-key="ServiceTransactions_DisplayName"
    description-key="ServiceTransactions_Description"
    control-type="standard">

    <!--
      The control reads a client's stays from cp_cp_admission, ahb_intake and
      cp_sheltercheckin itself, using the contact whose form it sits on. The
      data-set below is only what lets it be hosted in a subgrid: it declares no
      bound columns, so it can sit on any view without asking the maker to map
      fields, and without tying the control to a particular table's schema.
    -->
    <data-set
      name="stays"
      display-name-key="Stays_DataSet_DisplayName"
      description-key="Stays_DataSet_Description"
      cds-data-set-options="displayCommandBar:false;displayViewSelector:false;displayQuickFind:false">
    </data-set>

    <!-- ================= DESIGNER INPUTS ================= -->
    <property name="Title"
              of-type="SingleLine.Text"
              usage="input"
              display-name-key="Prop_Title"
              description-key="Prop_Title_Desc" />

    <property name="RowsPerPage"
              of-type="Whole.None"
              usage="input"
              display-name-key="Prop_RowsPerPage"
              description-key="Prop_RowsPerPage_Desc" />

    <!-- ================= RESOURCES ================= -->
    <resources>
      <code path="index.ts" order="1" />
    </resources>

    <!-- ================= FEATURE USAGE ================= -->
    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>

  </control>
</manifest>
