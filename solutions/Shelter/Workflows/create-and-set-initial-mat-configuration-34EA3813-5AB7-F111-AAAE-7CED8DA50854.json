        "Mat_plan_id": {
          "type": "Compose",
          "inputs": "@coalesce(first(outputs('Find_the_mat_plan')?['body/value'])?['cp_matplanid'], outputs('Create_mat_plan')?['body/cp_matplanid'])",
          "runAfter": {
