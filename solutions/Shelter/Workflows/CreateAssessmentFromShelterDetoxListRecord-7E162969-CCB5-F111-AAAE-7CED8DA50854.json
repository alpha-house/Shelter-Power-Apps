{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "api": {
          "name": "shared_commondataserviceforapps"
        },
        "connection": {
          "connectionReferenceLogicalName": "cp_sharedcommondataserviceforapps_04f4e"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "When_Create_Detox_Assessment_is_set_to_true": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "cp_shelterdetoxlist",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "cp_createdetoxassessment",
              "subscriptionRequest/filterexpression": "cp_createdetoxassessment eq true and _cp_detoxassessment_value eq null"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "connectionName": "shared_commondataserviceforapps"
            }
          }
        }
      },
      "actions": {
        "Has_a_client": {
          "type": "If",
          "expression": {
            "not": {
              "equals": [
                "@empty(triggerOutputs()?['body/_cp_client_value'])",
                true
              ]
            }
          },
          "actions": {
            "Get_the_client": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "contacts",
                  "recordId": "@triggerOutputs()?['body/_cp_client_value']"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "connectionName": "shared_commondataserviceforapps"
                }
              }
            },
            "Create_the_assessment": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "cp_assessments",
                  "item/cp_assessmentdateandtime": "@utcNow()",
                  "item/cp_dateofbirth": "@outputs('Get_the_client')?['body/cp_dateofbirth']",
                  "item/cp_firstname": "@outputs('Get_the_client')?['body/firstname']",
                  "item/cp_gender": "@outputs('Get_the_client')?['body/cp_gender']",
                  "item/cp_lastname": "@outputs('Get_the_client')?['body/lastname']",
                  "item/cp_newclient": 121570001,
                  "item/cp_Client@odata.bind": "@concat('/contacts(', triggerOutputs()?['body/_cp_client_value'], ')')",
                  "item/cp_ShelterDetoxList@odata.bind": "@concat('/cp_shelterdetoxlists(', triggerOutputs()?['body/cp_shelterdetoxlistid'], ')')"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "connectionName": "shared_commondataserviceforapps"
                }
              },
              "runAfter": {
                "Get_the_client": [
                  "Succeeded"
                ]
              }
            },
            "Link_the_assessment_to_the_detox_list_record": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "cp_shelterdetoxlists",
                  "recordId": "@triggerOutputs()?['body/cp_shelterdetoxlistid']",
                  "item/cp_createdetoxassessment": false,
                  "item/cp_DetoxAssessment@odata.bind": "@concat('/cp_assessments(', outputs('Create_the_assessment')?['body/cp_assessmentid'], ')')"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "UpdateOnlyRecord",
                  "connectionName": "shared_commondataserviceforapps"
                }
              },
              "runAfter": {
                "Create_the_assessment": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {
              "Fail_no_client_on_the_detox_list_record": {
                "type": "Terminate",
                "inputs": {
                  "runStatus": "Failed",
                  "runError": {
                    "code": "NoClientOnDetoxListRecord",
                    "message": "Cannot create an assessment: this Shelter Detox List record has no Client. Set the Client, then switch Create Detox Assessment on again."
                  }
                }
              }
            }
          },
          "runAfter": {}
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}