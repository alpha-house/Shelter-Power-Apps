{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "api": {
          "name": "shared_commondataserviceforapps"
        },
        "connection": {
          "connectionReferenceLogicalName": "cp_sharedcommondataserviceforapps_04f4e"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "Every_5_minutes": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Minute",
            "interval": 1
          }
        }
      },
      "actions": {
        "List_due_wake_ups": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "entityName": "cp_sheltercheckins",
              "$select": "cp_sheltercheckinid,cp_wakeuptime,cp_wakeupmessage,cp_matlabel,_cp_client_value",
              "$filter": "statecode eq 0 and cp_wakeuptime le @{utcNow()} and (cp_wakeupnotified eq false or cp_wakeupnotified eq null) and (cp_checkout eq false or cp_checkout eq null)"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "connectionName": "shared_commondataserviceforapps"
            }
          },
          "runAfter": {}
        },
        "Any_wake_ups_due": {
          "type": "If",
          "expression": {
            "greater": [
              "@length(outputs('List_due_wake_ups')?['body/value'])",
              0
            ]
          },
          "actions": {
            "Get_team_setting": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "environmentvariabledefinitions",
                  "$select": "schemaname,defaultvalue",
                  "$filter": "schemaname eq 'cp_WakeUpNotificationTeam'",
                  "$expand": "environmentvariabledefinition_environmentvariablevalue($select=value)"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "connectionName": "shared_commondataserviceforapps"
                }
              }
            },
            "Team_name": {
              "type": "Compose",
              "inputs": "@coalesce(first(first(outputs('Get_team_setting')?['body/value'])?['environmentvariabledefinition_environmentvariablevalue'])?['value'], first(outputs('Get_team_setting')?['body/value'])?['defaultvalue'])",
              "runAfter": {
                "Get_team_setting": [
                  "Succeeded"
                ]
              }
            },
            "Get_team_members": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "teams",
                  "$select": "teamid,name",
                  "$filter": "name eq '@{replace(string(outputs('Team_name')), '''', '''''')}'",
                  "$expand": "teammembership_association($select=systemuserid,isdisabled)"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "connectionName": "shared_commondataserviceforapps"
                }
              },
              "runAfter": {
                "Team_name": [
                  "Succeeded"
                ]
              }
            },
            "Active_team_members": {
              "type": "Query",
              "inputs": {
                "from": "@coalesce(first(outputs('Get_team_members')?['body/value'])?['teammembership_association'], json('[]'))",
                "where": "@equals(item()?['isdisabled'], false)"
              },
              "runAfter": {
                "Get_team_members": [
                  "Succeeded"
                ]
              }
            },
            "Team_has_members": {
              "type": "If",
              "expression": {
                "greater": [
                  "@length(body('Active_team_members'))",
                  0
                ]
              },
              "actions": {
                "For_each_due_wake_up": {
                  "type": "Foreach",
                  "foreach": "@outputs('List_due_wake_ups')?['body/value']",
                  "actions": {
                    "Notification_data": {
                      "type": "Compose",
                      "inputs": {
                        "actions": [
                          {
                            "title": "Open check-in",
                            "data": {
                              "url": "?pagetype=entityrecord&etn=cp_sheltercheckin&id=@{items('For_each_due_wake_up')?['cp_sheltercheckinid']}"
                            }
                          }
                        ]
                      }
                    },
                    "For_each_team_member": {
                      "type": "Foreach",
                      "foreach": "@body('Active_team_members')",
                      "actions": {
                        "Send_in_app_notification": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "parameters": {
                              "entityName": "appnotifications",
                              "item/title": "⏰ Wake up: @{coalesce(items('For_each_due_wake_up')?['_cp_client_value@OData.Community.Display.V1.FormattedValue'], 'client')}@{if(empty(items('For_each_due_wake_up')?['cp_matlabel']), '', concat(' (Mat ', items('For_each_due_wake_up')?['cp_matlabel'], ')'))}",
                              "item/body": "@{coalesce(items('For_each_due_wake_up')?['cp_wakeupmessage'], 'No wake up message was left.')}",
                              "item/data": "@{string(outputs('Notification_data'))}",
                              "item/ttlinseconds": 86400,
                              "item/icontype": 100000003,
                              "item/ownerid@odata.bind": "/systemusers(@{items('For_each_team_member')?['systemuserid']})",
                              "item/priority": 200000001,
                              "item/toasttype": 200000000
                            },
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                              "operationId": "CreateRecord",
                              "connectionName": "shared_commondataserviceforapps"
                            }
                          }
                        }
                      },
                      "runAfter": {
                        "Notification_data": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Mark_wake_up_notified": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "entityName": "cp_sheltercheckins",
                          "recordId": "@items('For_each_due_wake_up')?['cp_sheltercheckinid']",
                          "item/cp_wakeupnotified": true
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                          "operationId": "UpdateOnlyRecord",
                          "connectionName": "shared_commondataserviceforapps"
                        }
                      },
                      "runAfter": {
                        "For_each_team_member": [
                          "Succeeded"
                        ]
                      }
                    }
                  }
                }
              },
              "else": {
                "actions": {
                  "Fail_no_recipients": {
                    "type": "Terminate",
                    "inputs": {
                      "runStatus": "Failed",
                      "runError": {
                        "code": "NoWakeUpRecipients",
                        "message": "Wake ups are due but team '@{outputs('Team_name')}' was not found or has no active members. Check the cp_WakeUpNotificationTeam environment variable. Nothing was marked notified."
                      }
                    }
                  }
                }
              },
              "runAfter": {
                "Active_team_members": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {
            "List_due_wake_ups": [
              "Succeeded"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}