                }
              },
              "runAfter": {},
              "else": {
                "actions": {
                  "Hide_non_standard_mat_and_unassign": {
                    "runAfter": {},
                    "type": "OpenApiConnection",
                    "inputs": {
                      "parameters": {
                        "entityName": "cp_mats",
                        "recordId": "@items('Apply_to_each_mat')?['cp_matid']",
                        "item/cp_render": false,
                        "item/cp_clientlabel": null,
                        "item/cp_Client@odata.bind": null,
                        "item/cp_ShelterCheckin@odata.bind": null,
                        "accept": "application/json;odata.metadata=minimal"
                      },
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                        "connectionName": "shared_commondataserviceforapps",
                        "operationId": "UpdateOnlyRecord"
                      },
                      "authentication": "@parameters('$authentication')"
                    }
                  }
                }
              },
              "expression": {
                "equals": [
                  "@items('Apply_to_each_mat')?['cp_standardmat']",
                  true
                ]
              },
              "type": "If"
            }
          },
          "runAfter": {
            "List_all_mats": [
              "Succeeded"
            ]
          },
          "type": "Foreach",
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 20
            }
          }
        },
        "Clear_the_reset_flag": {
          "runAfter": {
